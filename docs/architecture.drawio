                <mxCell id="31" value="KAFKA CLUSTER" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="170" y="60" width="150" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;TOPICS, BROKERS AND PARTITION&lt;/h1&gt;&lt;div&gt;The event first goes through the kafka associated topic and the event is then partitioned (with an offset added to track individual events) and goes into the leader broker where consumers read events from.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;For reliability and redundancy, the data in the leader broker is replicated across several follower brokers.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;The brokers are configured to keep events for 7 days before disposing them off&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="180" y="300" width="210" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="34" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;AGGREGATE&lt;/h1&gt;&lt;div&gt;The events are aggregated on a per minutes basis where events collected per 30 seconds are aggregated and stored in a postgres Database&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;There is a 30 second tumbling window with flush on timer&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Each row contains window_start, product category, conversion_rate, total_orders, avg_orders, unique_products_per_order, total_price_per_product, total_quantity_per_product, avg_orders_per_continent, avg_orders_per_gender&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="610" y="300" width="200" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="35" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;LOAD&lt;/h1&gt;&lt;div&gt;The aggregated metrics are logged to postgres&lt;br&gt;&lt;br&gt;Timestamp is indexed and used as the primary key.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="870" y="300" width="180" height="130" as="geometry"/>
                </mxCell>
