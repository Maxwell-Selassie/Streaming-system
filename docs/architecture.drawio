                <mxCell id="13" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;PRODUCER&lt;/h1&gt;&lt;div&gt;The producer is responsible for producing events for downstream use cases.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The Kafka producer uses a hashed key associated with an event to decide which partition to send an event to.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Each event has a key/value pair, metadata and a hashed partition key&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-30" y="300" width="180" height="260" as="geometry"/>
