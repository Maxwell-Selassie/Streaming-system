                <mxCell id="31" value="KAFKA CLUSTER" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="170" y="60" width="150" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;TOPICS, BROKERS AND PARTITION&lt;/h1&gt;&lt;div&gt;The event first goes through the kafka associated topic and the event is then partitioned (with an offset added to track individual events) and goes into the leader broker where consumers read events from.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;For reliability and redundancy, the data in the leader broker is replicated across several follower brokers.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;The brokers are configured to keep events for 7 days before disposing them off&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;BROKERS (3 PARTITIONS)&lt;/div&gt;&lt;div&gt;LEADER + 1 REPLICA&lt;/div&gt;&lt;div&gt;OFFSET TRACKING PER GROUP&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="180" y="300" width="210" height="400" as="geometry"/>
                </mxCell>
